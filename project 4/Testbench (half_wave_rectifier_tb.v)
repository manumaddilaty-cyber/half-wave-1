`timescale 1ns/1ps

module half_wave_rectifier_tb;

reg clk;
reg rst;
reg signed [7:0] in_signal;
wire signed [7:0] out_signal;

half_wave_rectifier uut(
    .clk(clk),
    .rst(rst),
    .in_signal(in_signal),
    .out_signal(out_signal)
);

always #5 clk = ~clk;

initial begin

clk = 0;
rst = 1;
in_signal = 0;

#10 rst = 0;

#10 in_signal = 20;
#10 in_signal = 40;
#10 in_signal = -15;
#10 in_signal = -50;
#10 in_signal = 30;
#10 in_signal = -10;
#10 in_signal = 60;

#20 $finish;

end

initial begin
    $monitor("Time=%0t Input=%d Output=%d", $time, in_signal, out_signal);
end

endmodule